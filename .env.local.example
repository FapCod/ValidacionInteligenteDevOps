# Variables de entorno para ValidaConfig
# Copia este archivo como .env.local y completa los valores

# ─── Supabase (públicas - seguro tenerlas en el cliente) ───────────────────
# Encuéntralas en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu_anon_key_aqui

# ─── Supabase Service Role (SOLO SERVIDOR - NUNCA con NEXT_PUBLIC_) ────────
# ⚠️  ESTA CLAVE ES SECRETA. Nunca la expongas en el cliente.
# Encuéntrala en: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu_service_role_key_aqui

# ─── Google Gemini AI (SOLO SERVIDOR - NUNCA con NEXT_PUBLIC_) ────────────
# ⚠️  ESTA CLAVE ES SECRETA. Nunca la expongas en el cliente.
# Consíguela gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...tu_gemini_api_key_aqui

# ─── URL de la aplicación ─────────────────────────────────────────────────
# En local: http://localhost:3000
# En Render: https://tu-app.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
