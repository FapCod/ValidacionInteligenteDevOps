# Variables de entorno para ValidaConfig
# Copia este archivo como .env.local y completa los valores

# ─── Supabase (públicas - seguro tenerlas en el cliente) ───────────────────
# Encuéntralas en: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu_anon_key_aqui

# ─── Supabase Service Role (SOLO SERVIDOR - NUNCA con NEXT_PUBLIC_) ────────
# ⚠️  ESTA CLAVE ES SECRETA. Nunca la expongas en el cliente.
# Encuéntrala en: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu_service_role_key_aqui

# ─── Google Gemini AI (SOLO SERVIDOR) ──────────────────────────────────────
# Consíguela gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# ─── OpenRouter API (IA Alternativa Gratis - ⚡ RECOMENDADA PARA ARCHIVOS GRANDES) ──
# Consíguela gratis en: https://openrouter.ai/
# Si configuras esta clave, la aplicación la usará como prioridad principal.
# Es ideal para archivos grandes porque los modelos gratuitos de OpenRouter
# no tienen los límites agresivos de TPM (Tokens Por Minuto) de Groq.
OPENROUTER_API_KEY=key_...tu_openrouter_key_aqui
# Modelos sugeridos gratuitos:
# - meta-llama/llama-3-8b-instruct:free (Estable y rápido)
# - google/gemini-2.5-flash:free (Muy inteligente)
# - google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=openrouter/free

# ─── Groq API (IA Alternativa Gratis) ──────────────────────────────────────
# Consíguela gratis en: https://console.groq.com/
# Si configuras esta clave (y no tienes OpenRouter), usará Groq.
GROQ_API_KEY=gsk_...tu_groq_key_aqui
GROQ_MODEL=llama-3.1-8b-instant

# ─── URL de la aplicación ─────────────────────────────────────────────────
# En local: http://localhost:3000
# En Render: https://tu-app.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
